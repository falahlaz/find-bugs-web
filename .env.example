# Copy to ~/.config/findbugs/findbugs.env and chmod 600.

# --- Server ---
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_URL=https://findbugs.arunoir.space
DB_PATH=data/findbugs.db
TIMEZONE=Asia/Jakarta
COOKIE_SECURE=true
# SESSION_TTL=12h
# LOG_LEVEL=info

# --- Queue (defaults shown) ---
# QUEUE_MAX=10
# QUEUE_PER_USER=3
# WAITING_EXPIRY=30m
# JOB_RECHECK_AFTER=5m
# JOB_TIMEOUT=15m
# WATCHDOG_INTERVAL=1m
# DEDUP_WINDOW=24h
# RETENTION_RAW_LOG_DAYS=7
# RETENTION_DIAGNOSIS_DAYS=180
# Per-job unredacted Splunk log files (downloadable by engineers and the job's QA), purged hourly
# RETENTION_LOG_FILE_DAYS=3
# trace-report knowledge base shown on the Laporan page (QA: report.html only)
# KNOWLEDGE_DIR=$HOME/knowledge
# MyTelkomsel tools (/tools): cipher passwords JSON (shape of mytsel-tools'
# config/ciphers.example.json) and the services' RSA private.pem, both chmod 600.
# Any cipher can also come from TSEL_<PRODUCTION|OTHER|FALLBACK>_<PACKAGE_PASSWORD|
# PAYMENT_PASSWORD|PAYMENT_IV|IDENTIFIER_PASSWORD[_<CIPHERID>]>, which wins over the file.
# TSEL_CIPHERS_FILE=$HOME/.config/findbugs/tsel-ciphers.json
# TSEL_PRIVATE_KEY_PATH=$HOME/.config/findbugs/tsel-private.pem
TRANSACTION_ID_HEADER=X-Transaction-ID

# --- GlobalProtect ---
GP_PORTAL=vpn.example.com
GP_REACH_HOSTS=splunk.example.com:443
# GP_BIN=/usr/bin/globalprotect
# GP_WEB_DIR=~/.gp-web

# --- Splunk ---
SPLUNK_URL=https://splunk.example.com
SPLUNK_SSO_DOMAIN=login.microsoftonline.com
SPLUNK_SPL_TEMPLATES={"prod":"index=app_prod \"{transaction_id}\"","staging":"index=app_stg \"{transaction_id}\""}
SPLUNK_API_SESSION_PATH=data/splunk_api_session.json
SPLUNK_SKIP_SSL_VERIFY=false
# Seconds per HTTP request to Splunk (create job, poll, fetch results)
# SPLUNK_REQUEST_TIMEOUT=300
# SPLUNK_RESULT_WAIT_TIMEOUT=30
# SPLUNK_POLL_INTERVAL=2
# MAX_LOG_LINES=5000
# Max backend _id values re-searched when the service logs the transaction under
# its own ID (e.g. service-payment-migration); 0 = off
# SPLUNK_CORRELATION_MAX_IDS=5
SPLUNK_LOGIN_CMD=xvfb-run -a /home/<user>/findbugs/.venv/bin/python scripts/splunk-login/save_session_auto.py
SPLUNK_LOGIN_EVIDENCE_DIR=data/login-evidence
# Chromium profile kept between logins so a still-valid SSO sign-in skips the
# 2FA push (default: splunk-browser-profile next to SPLUNK_API_SESSION_PATH)
# SPLUNK_BROWSER_PROFILE_DIR=data/splunk-browser-profile
# Credentials used by the login script (2FA push goes to this account's phone)
SPLUNK_SSO_EMAIL=
SPLUNK_SSO_EMPLOYEE_ID=
SPLUNK_SSO_PASSWORD=

# --- Analyzer (Claude Code CLI, headless, no tools) ---
ANALYZER=claude
ANTHROPIC_API_KEY=
# CLAUDE_BIN=claude
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_TIMEOUT=5m

# --- Code trace (optional): trace internal errors to the service code in GitLab ---
# Enabled when GITLAB_URL and GITLAB_TOKEN are set. Needs the VPN. The token
# needs the read_repository and read_api scopes (read_api finds the deployed
# commit); it is passed to git per command and never written to .git/config.
GITLAB_URL=
# Any non-empty name works for a personal/project access token; deploy tokens
# need their own username.
# GITLAB_USERNAME=oauth2
GITLAB_TOKEN=
# Internal root CA (PEM) for GitLab's TLS cert, or skip verification instead
# GITLAB_CA_FILE=
# GITLAB_SKIP_SSL_VERIFY=false
# Shallow repos live in <dir>/<group>/<project>, one worktree per commit in
# <dir>/.worktrees/<group>/<project>@<sha>; unused worktrees are removed after
# GITLAB_WORKTREE_TTL_DAYS (0 keeps them)
# GITLAB_REPOS_DIR=$HOME/gitlab-services
# GITLAB_WORKTREE_TTL_DAYS=14
# The Kubernetes container name in the Splunk source path maps to
# <GITLAB_GROUP>/<container>; override per container with a JSON map
# GITLAB_GROUP=my-telkomsel
# GITLAB_REPO_MAP={"container-name":"group/project"}
# The namespace in the Splunk source path picks the GitLab environment whose
# last successful deploy-eks:<env> job before the error is traced; unknown
# namespaces are traced on GITLAB_REF.
# GITLAB_ENV_MAP={"tdw-dev":"dev","tdw-staging":"staging","tdw-preprod":"preprod","blue":"blue","tdw-webapi":"production"}
# GITLAB_REF=main
# The services' assets/*.json are for local development; the servers load
# ConfigMaps built from this repo, one branch per GitLab environment (same
# name unless mapped). A trace reads its JSON files at the commit the last
# successful <GITLAB_CONFIG_DEPLOY_JOB>* job deployed before the error (else
# the last commit before it), from a blobless clone pulled before each use.
# "-" turns this off.
# GITLAB_CONFIG_PROJECT=my-telkomsel/devsecops/json-config-updater
# GITLAB_CONFIG_PATH=json-files
# GITLAB_CONFIG_BRANCH_MAP={"production":"production"}
# GITLAB_CONFIG_DEPLOY_JOB=deploy_configmaps
# GITLAB_GIT_TIMEOUT=3m
# Full clones made from the Repo page (engineer); also works with
# CODE_TRACE_ENABLED=false
# GITLAB_CLONE_TIMEOUT=15m
# CODE_TRACE_MAX_REPOS=3
# Model for the code-tracing pass (the log diagnosis keeps CLAUDE_MODEL)
# CODE_TRACE_MODEL=claude-opus-5-5
# CODE_TRACE_TIMEOUT=8m
# CODE_TRACE_ENABLED=true
# Trace chat: shown closed after this long without a message (reopenable);
# Claude session files deleted after the retention; turns running at once
# TRACE_SESSION_IDLE=10m
# TRACE_SESSION_RETENTION_DAYS=30
# TRACE_CHAT_CONCURRENCY=2

# --- MR Triage page (engineer only; the old mymrs CLI) ---
# Lists the GITLAB_TOKEN owner's MRs (created_by_me) whose title has
# "| <author> |". Needs GITLAB_URL and GITLAB_TOKEN (works with
# CODE_TRACE_ENABLED=false). Merging from the page needs the token's api
# scope; with read_api only, Merge answers with a scope error.
# MR_TRIAGE_AUTHOR=Falah

# --- Telegram group notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Repo page: Claude Remote Control sessions (engineer only) ---
# Lists the repos in GITLAB_REPOS_DIR and starts/stops `claude rc` in tmux
# through the rc-session skill's script (disabled when it is missing). The
# script runs with a minimal environment (no tokens from this file) in its own
# systemd user scope, so sessions survive a restart of the website; set the
# launcher to - to run the script directly.
# RC_SESSION_SCRIPT=$HOME/.claude/skills/rc-session/rc-session.sh
# RC_SESSION_LAUNCHER=systemd-run --user --scope --quiet --collect --
