# Copy to ~/.config/findbugs/findbugs.env and chmod 600.

# --- Server ---
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_URL=https://findbugs.arunoir.space
DB_PATH=data/findbugs.db
TIMEZONE=Asia/Jakarta
COOKIE_SECURE=true
# SESSION_TTL=12h
# LOG_LEVEL=info

# --- Queue (defaults shown) ---
# QUEUE_MAX=10
# QUEUE_PER_USER=3
# WAITING_EXPIRY=30m
# JOB_RECHECK_AFTER=5m
# JOB_TIMEOUT=15m
# WATCHDOG_INTERVAL=1m
# DEDUP_WINDOW=24h
# RETENTION_RAW_LOG_DAYS=30
# RETENTION_DIAGNOSIS_DAYS=180
TRANSACTION_ID_HEADER=X-Transaction-ID

# --- GlobalProtect ---
GP_PORTAL=vpn.example.com
GP_REACH_HOSTS=splunk.example.com:443
# GP_BIN=/usr/bin/globalprotect
# GP_WEB_DIR=~/.gp-web

# --- Splunk ---
SPLUNK_URL=https://splunk.example.com
SPLUNK_SSO_DOMAIN=login.microsoftonline.com
SPLUNK_SPL_TEMPLATES={"prod":"index=app_prod \"{transaction_id}\"","staging":"index=app_stg \"{transaction_id}\""}
SPLUNK_API_SESSION_PATH=data/splunk_api_session.json
SPLUNK_SKIP_SSL_VERIFY=false
# Seconds per HTTP request to Splunk (create job, poll, fetch results)
# SPLUNK_REQUEST_TIMEOUT=300
# SPLUNK_RESULT_WAIT_TIMEOUT=30
# SPLUNK_POLL_INTERVAL=2
# MAX_LOG_LINES=5000
SPLUNK_LOGIN_CMD=xvfb-run -a /home/<user>/findbugs/.venv/bin/python scripts/splunk-login/save_session_auto.py
SPLUNK_LOGIN_EVIDENCE_DIR=data/login-evidence
# Credentials used by the login script (2FA push goes to this account's phone)
SPLUNK_SSO_EMAIL=
SPLUNK_SSO_EMPLOYEE_ID=
SPLUNK_SSO_PASSWORD=

# --- Analyzer (Claude Code CLI, headless, no tools) ---
ANALYZER=claude
ANTHROPIC_API_KEY=
# CLAUDE_BIN=claude
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_TIMEOUT=5m

# --- Telegram group notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
