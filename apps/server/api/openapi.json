          },
          "startedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "timeRange": {
            "type": "string"
          },
          "transactionId": {
            "type": "string"
          },
          "userId": {
            "format": "int64",
